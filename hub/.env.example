# setup.sh copies this to .env and fills in the blanks with random values. Keep .env private.
INFLUX_ORG=tankwatch
INFLUX_BUCKET=sensors
# How long to keep readings: 0 = forever, or e.g. 365d
INFLUX_RETENTION=0
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=
INFLUX_ADMIN_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# The admin page (http://<hub>:8088, user admin)
ADMIN_PASSWORD=
# Created by setup.sh: read-only (Grafana) and write-only (sensor nodes)
INFLUX_READ_TOKEN=
NODE_WRITE_TOKEN=
# Filled in by setup.sh: which hub this is, and its name on the network
HUB_ID=
HUB_NAME=
# Ports other devices use. Change them only if something else on this machine already uses one.
# (The discovery beacon is always 8087.) Collectors learn the InfluxDB port from their join code and the beacon.
INFLUX_PORT=8086
GRAFANA_PORT=3000
ADMIN_PORT=8088
# Leave empty to detect automatically. Set it if setup.sh prints the wrong address.
HUB_ADDRESS=
# Written by setup.sh each run: the address it found, used by the admin page's join codes
HUB_DETECTED_ADDRESS=
# Phone widget (optional add-on). ./setup.sh widget turns it on by adding "widget" here; ./setup.sh widget off
# removes it. See docs/phone-widget.md
COMPOSE_PROFILES=
WIDGET_PORT=8089
# Created by setup.sh: lets the admin page pair phones through the widget service
WIDGET_ADMIN_TOKEN=
# The widget service's address from away from home. Leave empty to use the hub's Tailscale address, which
# setup.sh finds each run (WIDGET_DETECTED_REMOTE_URL); set it to use something else, e.g. a Funnel address.
WIDGET_REMOTE_URL=
WIDGET_DETECTED_REMOTE_URL=
# Healthy ranges in °F (low,high): outside them the widget shows blue (cold) or orange (hot)
WATER_RANGE_F=74,82
AIR_RANGE_F=68,80
