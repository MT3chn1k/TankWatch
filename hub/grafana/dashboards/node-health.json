{
  "uid": "tankwatch-health",
  "title": "TankWatch – Node health",
  "tags": [
    "tankwatch"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 4,
      "type": "stat",
      "title": "Reporting now (silent 90 s = DOWN)",
      "datasource": {
        "type": "influxdb",
        "uid": "tankwatch-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "tankwatch-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -24h, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"node_health\" and contains(value: r.node, set: ${node:json}))\n  |> filter(fn: (r) => r._field == \"load1\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _field: r.node,\n      _value: if uint(v: now()) - uint(v: r._time) <= uint(v: 90s) then 1 else 0}))\n  |> group(columns: [\"_field\"])\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP"
                },
                "0": {
                  "text": "DOWN"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Undervolt now",
      "datasource": {
        "type": "influxdb",
        "uid": "tankwatch-influx"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
