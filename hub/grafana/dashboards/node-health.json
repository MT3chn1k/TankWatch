  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "tankwatch-influx"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"node\", predicate: (r) => r._measurement == \"node_health\", start: -30d)"
      },
      {
        "name": "unit",
        "label": "Units",
        "type": "custom",
        "query": "°F : temp_f,°C : temp_c",
        "current": {
          "text": "°F",
          "value": "temp_f"
        },
        "options": [
          {
            "text": "°F",
            "value": "temp_f",
            "selected": true
          },
          {
            "text": "°C",
            "value": "temp_c",
            "selected": false
          }
        ]
      }
    ]
