# Hub address and the write-only token printed by hub/setup.sh
INFLUX_URL=http://tankwatch-hub.local:8086
INFLUX_ORG=tankwatch
INFLUX_BUCKET=sensors
INFLUX_TOKEN=paste-the-node-write-token-here
# Name this node shows up as in Grafana (defaults to the host name)
TANKWATCH_NODE=node1
# Host's gpio group id, for DHT sensors: getent group gpio | cut -d: -f3
GPIO_GID=997
